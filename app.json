{
  "expo": {
    "name": "Xself",
    "slug": "xself-home",
    "scheme": "xselfhome",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash/splash-screen.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#222F42"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xself.home",
      "buildNumber": "35",
      "infoPlist": {
        "NSCameraUsageDescription": "Use your camera to search for furniture and upload photos for customer support."
      },
      "associatedDomains": [
        "applinks:xselfhome.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#023143"
      },
      "package": "com.xself.home"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": "1.0.13",
    "updates": {
      "url": "https://u.expo.dev/3d5a36de-d144-4e6c-ac40-c336e8a8aac2",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3d5a36de-d144-4e6c-ac40-c336e8a8aac2"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Xself to access your photos to search similar products.",
          "cameraPermission": "Allow Xself to use your camera to search similar products."
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [
            "merchant.com.xself.home"
          ],
          "enableGooglePay": false
        }
      ],
      [
        "react-native-crisp-chat-sdk",
        {
          "websiteId": "37dc2a19-ef77-42c9-bd9a-7731033293bd"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3519409408954811~6941537191"
        }
      ]
    ]
  }
}
