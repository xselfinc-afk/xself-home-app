# .easignore — files excluded from the EAS Build archive upload.
#
# Goal: keep the upload under a few hundred MB and never include scraper
# session tokens or local logs. Anything required by the iOS build (xcodeproj,
# xcworkspace, app sources, native config, supabase function code) is left
# intact.

# Logs and diagnostic artifacts
logs/
*.log
logs/giga-debug-*.html
logs/giga-debug-*.png

# Local temp / scratch
tmp/
backups/
exports/

# Tool caches / IDE local state
.claude/
.opencode/
.DS_Store

# Node + cocoapods caches
node_modules/
ios/Pods/
ios/build/

# Android build artifacts (iOS release does not need them)
android/

# Scraper local state — never ship these to a remote builder
scripts/.giga-chrome-profile/
scripts/.giga-session*.json
scripts/.giga-session.json

# Debug output + Deno lockfile (local only; not needed by the iOS build)
scripts/debug-output/
deno.lock

# Local archives
*.tar
*.zip

# Environment files — the builder gets EXPO_PUBLIC_* from the EAS "production"
# environment store, so no local .env is needed on the remote builder. Never
# ship .env.local (holds SUPABASE_SERVICE_ROLE_KEY / SUPPLIER_CLIENT_SECRET).
.env
.env.*

# Web export — not part of the iOS build
dist/

# Expo local cache
.expo/

# Docs / audit reports / wiki — not needed by the iOS build
docs/
wiki/
reports/

# Local sample product images (~74 MB) — not required by the app (product images load
# from the CDN via variantUrl/originalUrl). The Home hero now lives at
# assets/home/home-hero.jpg (outside this folder), so exclude the whole folder.
assets/products/

# Loose scraper debug screenshots left in scripts/
scripts/.giga-*.png
scripts/.last-scrape.png
scripts/*.png
