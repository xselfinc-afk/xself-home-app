{
  "name": "xself-home",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "inventory:save-session": "tsx scripts/saveGigaSession.ts",
    "giga:refresh-session": "tsx scripts/refreshGigaSession.ts",
    "giga:saved:plan": "tsx scripts/planGigaSavedItems.ts",
    "giga:saved:baseline": "tsx scripts/giga-saved-baseline.ts",
    "giga:saved:delta": "tsx scripts/giga-saved-delta.ts",
    "giga:newly-saved:plan": "tsx scripts/planGigaNewlySavedCandidates.ts",
    "giga:newly-saved:sync:dry": "DRY_RUN=1 tsx scripts/syncGigaNewlySavedCandidates.ts",
    "giga:newly-saved:sync": "tsx scripts/syncGigaNewlySavedCandidates.ts --sync",
    "giga:saved-to-live:plan": "tsx scripts/gigaSavedToLiveOrchestrator.ts",
    "giga:saved-to-live:apply": "tsx scripts/gigaSavedToLiveOrchestrator.ts --apply",
    "fees:refresh:dry": "DRY_RUN=1 tsx scripts/refreshGigaDeliveryFeesHybrid.ts",
    "fees:refresh": "tsx scripts/refreshGigaDeliveryFeesHybrid.ts",
    "fees:refresh:all": "tsx scripts/refreshGigaDeliveryFeesHybrid.ts --all",
    "fees:refresh:portal:dry": "DRY_RUN=1 tsx scripts/refreshGigaDeliveryFees.ts",
    "fees:refresh:portal": "tsx scripts/refreshGigaDeliveryFees.ts",
    "fees:refresh:portal:all": "tsx scripts/refreshGigaDeliveryFees.ts --all",
    "test:delivery-fee-refresh": "tsx src/__tests__/deliveryFeeRefresh.test.ts",
    "test:delivery-fee-cache": "tsx src/__tests__/deliveryFeeCache.test.ts",
    "guard:prod": "tsx scripts/productionGuardrails.ts",
    "verify:before-final": "npm run guard:prod",
    "ios:clean-rebuild": "bash scripts/iosCleanRebuild.sh",
    "inventory:install-local": "bash scripts/installLocalInventorySync.sh install",
    "inventory:uninstall-local": "bash scripts/installLocalInventorySync.sh uninstall",
    "inventory:status-local": "bash scripts/installLocalInventorySync.sh status",
    "inventory:run-now-local": "bash scripts/installLocalInventorySync.sh run-now",
    "inventory:sync": "bash scripts/runGigaInventorySync.sh",
    "inventory:sync:dry": "DRY_RUN=1 INVENTORY_LIMIT=2 bash scripts/runGigaInventorySync.sh",
    "inventory:sync:full": "INVENTORY_FULL_SYNC=1 bash scripts/runGigaInventorySync.sh",
    "inventory:repair-env": "bash scripts/repairInventorySyncEnvironment.sh",
    "inventory:health": "bash scripts/inventoryHealthReport.sh",
    "inventory:doctor": "npm run inventory:status-local && npm run inventory:repair-env",
    "inventory:verify": "tsx scripts/verifyInventoryFreshness.ts",
    "inventory:curl:import": "tsx scripts/importGigaInventoryCurl.ts",
    "inventory:curl:fetch": "tsx scripts/fetchGigaWarehouseInventoryFromCurl.ts",
    "inventory:http:sync": "tsx scripts/syncGigaWarehouseInventoryHttp.ts",
    "inventory:http:sync:dry": "DRY_RUN=1 INVENTORY_LIMIT=5 tsx scripts/syncGigaWarehouseInventoryHttp.ts",
    "inventory:html:fetch": "tsx scripts/fetchGigaWarehouseInventoryFromHtml.ts",
    "inventory:xhr:discover": "tsx scripts/discoverGigaWarehouseXhr.ts",
    "inventory:xhr:fetch": "tsx scripts/fetchGigaWarehouseInventoryFromXhr.ts",
    "inventory:xhr:probe": "tsx scripts/probeGigaProductXhr.ts",
    "inventory:xhr:sync": "tsx scripts/syncGigaInventoryXhr.ts",
    "inventory:xhr:sync:dry": "DRY_RUN=1 INVENTORY_LIMIT=5 tsx scripts/syncGigaInventoryXhr.ts",
    "sync:ios-version": "node scripts/syncIosNativeVersion.js",
    "version:bump": "node scripts/bumpReleaseVersion.js",
    "release:ios:plan": "tsx scripts/iosReleasePlan.ts",
    "release:ios:prepare": "tsx scripts/iosReleasePrepare.ts",
    "release:ios:submit": "bash scripts/releaseIosProduction.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@stripe/stripe-react-native": "^0.64.0",
    "@supabase/supabase-js": "^2.103.3",
    "babel-preset-expo": "^54.0.10",
    "expo": "^54.0.33",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-updates": "~29.0.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-crisp-chat-sdk": "^0.23.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "@urql/core": "^6.0.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "blurhash": "^2.0.5",
    "dotenv-cli": "^11.0.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
